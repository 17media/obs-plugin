#!/bin/bash

# Plugin directory
PLUGINS_DIR="/Applications/OBS.app/Contents/PlugIns"
PLUGIN_NAME="obs-17live.plugin"

# Ensure plugin directory exists
if [ ! -d "$PLUGINS_DIR" ]; then
    mkdir -p "$PLUGINS_DIR"
    echo "Created plugin directory: $PLUGINS_DIR"
fi

# Remove old plugin files
if [ -d "$PLUGINS_DIR/$PLUGIN_NAME" ]; then
    rm -rf "$PLUGINS_DIR/$PLUGIN_NAME"
    echo "Removed old plugin: $PLUGIN_NAME"
fi

# Remove debug symbol files (dSYM)
if [ -d "$PLUGINS_DIR/$PLUGIN_NAME.dSYM" ]; then
    rm -rf "$PLUGINS_DIR/$PLUGIN_NAME.dSYM"
    echo "Removed old plugin dSYM: $PLUGIN_NAME.dSYM"
fi

exit 0