#!/bin/bash

PLUGIN_NAME="obs-17live.plugin"

SYSTEM_PLUGINS_DIR="/Library/Application Support/obs-studio/plugins"

CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)"
USER_PLUGINS_DIR=""
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
  USER_PLUGINS_DIR="/Users/$CONSOLE_USER/Library/Application Support/obs-studio/plugins"
fi

if [ -n "$USER_PLUGINS_DIR" ] && [ -d "$SYSTEM_PLUGINS_DIR/$PLUGIN_NAME" ]; then
  /bin/mkdir -p "$USER_PLUGINS_DIR"
  /bin/rm -rf "$USER_PLUGINS_DIR/$PLUGIN_NAME"
  /usr/bin/ditto "$SYSTEM_PLUGINS_DIR/$PLUGIN_NAME" "$USER_PLUGINS_DIR/$PLUGIN_NAME"

  /usr/sbin/chown -R "$CONSOLE_USER:staff" "$USER_PLUGINS_DIR/$PLUGIN_NAME" 2>/dev/null || true
  /bin/chmod 755 "$USER_PLUGINS_DIR" 2>/dev/null || true
  /bin/chmod -R 755 "$USER_PLUGINS_DIR/$PLUGIN_NAME" 2>/dev/null || true

  /usr/bin/xattr -dr com.apple.quarantine "$USER_PLUGINS_DIR/$PLUGIN_NAME" 2>/dev/null || true

  /bin/rm -rf "$SYSTEM_PLUGINS_DIR/$PLUGIN_NAME" 2>/dev/null || true
  /bin/rm -rf "$SYSTEM_PLUGINS_DIR/$PLUGIN_NAME.dSYM" 2>/dev/null || true
fi

exit 0
