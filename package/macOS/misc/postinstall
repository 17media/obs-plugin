#!/bin/bash

PLUGIN_NAME="obs-17live.plugin"

TARGET_VOLUME="$3"
INSTALL_LOCATION="$2"
PLUGINS_DIR="${TARGET_VOLUME%/}${INSTALL_LOCATION}/Library/Application Support/obs-studio/plugins"

if [ -d "$PLUGINS_DIR/$PLUGIN_NAME" ]; then
  /bin/chmod 755 "$PLUGINS_DIR" 2>/dev/null || true
  /bin/chmod -R 755 "$PLUGINS_DIR/$PLUGIN_NAME" 2>/dev/null || true
  /usr/bin/xattr -dr com.apple.quarantine "$PLUGINS_DIR/$PLUGIN_NAME" 2>/dev/null || true
fi

exit 0
